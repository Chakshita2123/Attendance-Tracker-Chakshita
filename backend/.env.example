# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Get your connection string from MongoDB Atlas:
# Atlas format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# JWT Secret — used to sign and verify auth tokens.
# Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend origin — used by CORS in production to restrict cross-origin requests.
# Set this to your deployed app URL (e.g. https://my-app.onrender.com).
# In development this is unused; localhost:5173 is allowed automatically.
FRONTEND_URL=https://your-app.onrender.com

# Gemini API Key & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash
